NAME: Charger;

# Two robots share a charging station. Robot i asks for the station
# (req_i) when its battery is low (low_i); an arbiter grants it (grant_i).
# The comment at the end of a line is the number of the requirement in
# requirements.txt.

CONTRACT Robot1:
    input boolean variable low1;
    input boolean variable grant1;
    output boolean variable req1;
    Assumptions:
        G(F(grant1 | !req1));  # A1.1
    Guarantees:
        !req1;  # R1.1
        G(low1 -> X(req1));  # R2.1
        G(!low1 -> X(!req1));  # R3.1

CONTRACT Robot2:
    input boolean variable low2;
    input boolean variable grant2;
    output boolean variable req2;
    Assumptions:
        G(F(grant2 | !req2));  # A1.2
    Guarantees:
        !req2;  # R1.2
        G(low2 -> X(req2));  # R2.2
        G(!low2 -> X(!req2));  # R3.2

# First arbiter: each request is granted at the next step.
CONTRACT Greedy:
    input boolean variable req1;
    input boolean variable req2;
    output boolean variable grant1;
    output boolean variable grant2;
    Assumptions:
        true;
    Guarantees:
        !grant1;  # R4.1
        !grant2;  # R4.2
        G(req1 -> X(grant1));  # R6.1
        G(req2 -> X(grant2));  # R6.2
        G(!(grant1 & grant2));  # R5

# Second arbiter: each request is granted eventually.
CONTRACT Fair:
    input boolean variable req1;
    input boolean variable req2;
    output boolean variable grant1;
    output boolean variable grant2;
    Assumptions:
        true;
    Guarantees:
        !grant1;  # R4.1
        !grant2;  # R4.2
        G(!(grant1 & grant2));  # R5
        G(F(grant1 | !req1));  # R7.1
        G(F(grant2 | !req2));  # R7.2
        G(F(grant1 | !req1 | grant2));  # R8

# An arbiter that assumes that robot 1 drops its request after any grant.
CONTRACT Pushy:
    input boolean variable req1;
    input boolean variable req2;
    output boolean variable grant1;
    output boolean variable grant2;
    Assumptions:
        G(F(req1));  # A2
        G(grant1 -> X(!req1));  # A3
    Guarantees:
        G(!(grant1 & grant2));  # R5

# The same, but robot 1 drops its request only after a grant of it.
CONTRACT Polite:
    input boolean variable req1;
    input boolean variable req2;
    output boolean variable grant1;
    output boolean variable grant2;
    Assumptions:
        G(F(req1));  # A2
        G((req1 & grant1) -> X(!req1));  # A4
    Guarantees:
        G(!(grant1 & grant2));  # R5

# What the whole system must do.
CONTRACT System:
    input boolean variable low1;
    input boolean variable low2;
    output boolean variable req1;
    output boolean variable req2;
    output boolean variable grant1;
    output boolean variable grant2;
    Assumptions:
        true;
    Guarantees:
        G(F(grant1 | !req1));  # S1.1
        G(F(grant2 | !req2));  # S1.2
        G(!(grant1 & grant2));  # S2
